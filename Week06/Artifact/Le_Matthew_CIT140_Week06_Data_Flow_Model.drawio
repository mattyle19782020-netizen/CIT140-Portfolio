<mxfile data-assignment="CIT140-W06-DATA-FLOW" data-assignment-version="2026-10-18.1" host="app.diagrams.net" version="24.7.17"><diagram name="1 System boundary"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;CIT 140 · Week 6 · System boundary&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;text;strokeColor=none;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1089" height="45" as="geometry"/></mxCell><mxCell id="s1" value="System modeled: the Inspection Report Routing System. The Field Team supplies inspection reports and receives validation notes. Electrical, Drainage and Structures receive routed work items. Every arrow names the data that crosses the boundary. Internal processes and stores appear on page 2. [W06-S01]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;text;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1089" height="65" as="geometry"/></mxCell><mxCell id="system" value="Inspection Report&lt;br&gt;Routing System" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;ellipse;fillColor=#fff6e6;" vertex="1" parent="1"><mxGeometry x="440" y="255" width="280" height="200" as="geometry"/></mxCell><mxCell id="entity1" value="Field Team&lt;br&gt;(external source and recipient)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="220" height="110" as="geometry"/></mxCell><mxCell id="entity2" value="Electrical&lt;br&gt;(receiving department)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="870" y="180" width="220" height="90" as="geometry"/></mxCell><mxCell id="entity3" value="Drainage&lt;br&gt;(receiving department)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="870" y="350" width="220" height="90" as="geometry"/></mxCell><mxCell id="entity4" value="Structures&lt;br&gt;(receiving department)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="870" y="520" width="220" height="90" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b&gt;Inside the boundary:&lt;/b&gt; receiving the inspection report, checking the eight required fields, resolving the destination from the routing table, sending the work item, and the two internal stores D1 Report Register and D2 Routing Table.&lt;br&gt;&lt;b&gt;Outside the boundary:&lt;/b&gt; the Field Team; Electrical, Drainage and Structures; drone flight control, physical inspections and repair work; and maintenance of the Routing Table, which is performed by a service administrator.&lt;br&gt;&lt;b&gt;Sources:&lt;/b&gt; W06-S01 (boundary and processes), W06-S02 (report fields), W06-S03 (required destinations), W06-S04 (delivery log)." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="1089" height="110" as="geometry"/></mxCell><mxCell id="f1" value="inspection report&lt;br&gt;(eight required fields)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="entity1" target="system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="validation note" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="system" target="entity1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="work item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system" target="entity2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="work item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system" target="entity3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="work item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system" target="entity4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Information movement"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="&lt;b&gt;CIT 140 · Week 6 · Information movement&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;text;strokeColor=none;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1089" height="45" as="geometry"/></mxCell><mxCell id="s2" value="Inside the Inspection Report Routing System: four processes and two data stores. Each arrow names the data that moves, not the order of steps. External inputs and outputs match page 1. [W06-S01]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;text;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1089" height="65" as="geometry"/></mxCell><mxCell id="process0" value="1. Receive Report" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;ellipse;fillColor=#fff6e6;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="175" height="120" as="geometry"/></mxCell><mxCell id="process1" value="2. Check Required Fields" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;ellipse;fillColor=#fff6e6;" vertex="1" parent="1"><mxGeometry x="340" y="230" width="175" height="120" as="geometry"/></mxCell><mxCell id="process2" value="3. Resolve Destination" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;ellipse;fillColor=#fff6e6;" vertex="1" parent="1"><mxGeometry x="630" y="230" width="175" height="120" as="geometry"/></mxCell><mxCell id="process3" value="4. Send Work Item" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;ellipse;fillColor=#fff6e6;" vertex="1" parent="1"><mxGeometry x="920" y="230" width="175" height="120" as="geometry"/></mxCell><mxCell id="d1" value="D1 Report Register" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;shape=partialRectangle;top=1;bottom=1;left=0;right=0;" vertex="1" parent="1"><mxGeometry x="150" y="510" width="280" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 Routing Table" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;shape=partialRectangle;top=1;bottom=1;left=0;right=0;" vertex="1" parent="1"><mxGeometry x="577" y="510" width="280" height="90" as="geometry"/></mxCell><mxCell id="prompt" value="&lt;b&gt;Notes.&lt;/b&gt; P2 Check Required Fields tests the eight fields defined in W06-S02. A report that fails the check produces a validation note to the Field Team and does not continue to P3. P4 writes a delivery record to D1 Report Register; the delivery log in W06-S04 is an export of those records. The service administrator who maintains D2 Routing Table works outside this boundary, so table maintenance is not modelled here. [W06-S01]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1089" height="70" as="geometry"/></mxCell><mxCell id="ext_field" value="Field Team" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef4;strokeColor=#44546a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="175" height="50" as="geometry"/></mxCell><mxCell id="ext_electrical" value="Electrical" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef4;strokeColor=#44546a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="395" width="190" height="48" as="geometry"/></mxCell><mxCell id="ext_drainage" value="Drainage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef4;strokeColor=#44546a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="455" width="190" height="48" as="geometry"/></mxCell><mxCell id="ext_structures" value="Structures" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef4;strokeColor=#44546a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="515" width="190" height="48" as="geometry"/></mxCell><mxCell id="m1" value="inspection report" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ext_field" target="process0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2" value="received report" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="process0" target="process1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3" value="submitted report" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="process0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4" value="validation note" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="process1" target="ext_field"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m5" value="accepted report" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="process1" target="process2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m6" value="routing entry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="process2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m7" value="report with&#10;resolved destination" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="process2" target="process3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m8" value="delivery record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="process3" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="326"/><mxPoint x="880" y="462"/><mxPoint x="346" y="462"/></Array></mxGeometry></mxCell><mxCell id="m9" value="work item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="process3" target="ext_electrical"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m10" value="work item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="process3" target="ext_drainage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m11" value="work item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="process3" target="ext_structures"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Definitions and finding"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3" value="&lt;b&gt;CIT 140 · Week 6 · Definitions and finding&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;text;strokeColor=none;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1089" height="45" as="geometry"/></mxCell><mxCell id="s3" value="All eight required fields from W06-S02, with one traced routing discrepancy and the question the supplied records cannot answer." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;text;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1089" height="65" as="geometry"/></mxCell><mxCell id="h0" value="&lt;b&gt;Field&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;fillColor=#edf3f5;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="145" height="35" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;Meaning&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;fillColor=#edf3f5;" vertex="1" parent="1"><mxGeometry x="185" y="145" width="220" height="35" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;Example&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;fillColor=#edf3f5;" vertex="1" parent="1"><mxGeometry x="405" y="145" width="190" height="35" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;Allowed value / format&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;fillColor=#edf3f5;" vertex="1" parent="1"><mxGeometry x="595" y="145" width="285" height="35" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;Source&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;fillColor=#edf3f5;" vertex="1" parent="1"><mxGeometry x="880" y="145" width="249" height="35" as="geometry"/></mxCell><mxCell id="r0c0" value="report_id" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="145" height="48" as="geometry"/></mxCell><mxCell id="r0c1" value="Unique reference for one inspection report" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="185" y="180" width="220" height="48" as="geometry"/></mxCell><mxCell id="r0c2" value="CJ-601" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="180" width="190" height="48" as="geometry"/></mxCell><mxCell id="r0c3" value="CJ- followed by three digits" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="180" width="285" height="48" as="geometry"/></mxCell><mxCell id="r0c4" value="W06-S02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="249" height="48" as="geometry"/></mxCell><mxCell id="r1c0" value="asset_id" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="145" height="48" as="geometry"/></mxCell><mxCell id="r1c1" value="Reference for the inspected asset" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="185" y="228" width="220" height="48" as="geometry"/></mxCell><mxCell id="r1c2" value="SL-101" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="228" width="190" height="48" as="geometry"/></mxCell><mxCell id="r1c3" value="Two-letter prefix plus three digits" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="228" width="285" height="48" as="geometry"/></mxCell><mxCell id="r1c4" value="W06-S02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="228" width="249" height="48" as="geometry"/></mxCell><mxCell id="r2c0" value="asset_type" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="145" height="48" as="geometry"/></mxCell><mxCell id="r2c1" value="Kind of asset inspected; sets the required department" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="185" y="276" width="220" height="48" as="geometry"/></mxCell><mxCell id="r2c2" value="BRIDGE" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="276" width="190" height="48" as="geometry"/></mxCell><mxCell id="r2c3" value="STREETLIGHT, DRAIN or BRIDGE" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="276" width="285" height=