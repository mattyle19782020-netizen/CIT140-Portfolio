        <mxCell id="title" value="CIT 140 · Week 5 | Current Appointment Process" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#183c43;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="34" as="geometry"/></mxCell>
        <mxCell id="instructions" value="Process start: a visitor requests an appointment. Process end: Intake hands the visitor to the next staff team. Each step sits in the lane of the role responsible for it, and source IDs appear in brackets." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="visitor" value="Visitor" style="swimlane;horizontal=0;startSize=140;html=1;fillColor=#e8f1ef;strokeColor=#5a7c7d;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1080" height="90" as="geometry"/></mxCell>
