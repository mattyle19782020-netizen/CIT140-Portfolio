        <mxCell id="legend" value="Symbol key (copy these shapes into your lanes; they are not case steps)" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="1080" height="20" as="geometry"/></mxCell>
        <mxCell id="key-start" value="Start / end" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff7ee;strokeColor=#95694b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="772" width="120" height="36" as="geometry"/></mxCell>
